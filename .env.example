# Agent-Customer 环境变量示例（可选）
# 本项目主要通过 config.json 配置 LLM；此处仅作部署备忘。

# LLM_API_KEY=your-api-key
# LLM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL_NAME=doubao-seed-1-6-flash-250828

# Playwright 浏览器目录（app.py 默认使用项目根 .browsers）
# PLAYWRIGHT_BROWSERS_PATH=D:\agent\.browsers

# Phase 2b 起：handler 出站走 PinduoduoOutbound（Phase 2a 仅提供适配器，默认关闭）
# USE_PINDUODUO_OUTBOUND=false

# Phase 3b 起：AutoReplyThread 使用 PinduoduoChannel 包装层（默认关闭，仍用 legacy PDDChannel）
# USE_PINDUODUO_CHANNEL_WRAPPER=false
